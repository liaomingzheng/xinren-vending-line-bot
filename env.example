# LINE Developers 後台取得
LINE_CHANNEL_ACCESS_TOKEN=請貼上你的_Channel_Access_Token
LINE_CHANNEL_SECRET=請貼上你的_Channel_Secret

# Render / Railway 會自動指定 PORT，本機測試可用 3000
PORT=3000

# 以下先放你的實際網址；還沒做好可先放 Google 表單或 Google 地圖連結
SHOP_URL=https://example.com/shop
LOCATION_URL=https://example.com/location
STOCK_FORM_URL=https://example.com/stock-report
REPAIR_FORM_URL=https://example.com/repair-report
PARTNER_FORM_URL=https://example.com/partner-application

# 可選：客服電話或官方說明文字
SERVICE_PHONE=請填客服電話
